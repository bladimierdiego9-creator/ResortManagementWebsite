# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development

# Supabase Database Connection (Primary)
# Shared secret for the ESP32 -> Flask RFID endpoint. Generate a long random value.
RFID_DEVICE_TOKEN=replace-with-a-long-random-device-secret
# Direct connection URL (IPv6, port 5432)
DATABASE_URL=postgresql://postgres:your-password@your-project-ref.supabase.co:5432/postgres

# Session pooler URL (IPv4, recommended for most networks)
DATABASE_POOLER_URL=postgresql://postgres:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Connection Details (Alternative configuration)
SUPABASE_HOST=your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-password-here

# Local Database Fallback
# Used when Supabase is unreachable
LOCAL_DATABASE_URL=sqlite:///data/thysia_local.db

# Session Configuration
# Set to True when using HTTPS in production
SESSION_COOKIE_SECURE=False

# Application Settings
PERMANENT_SESSION_LIFETIME_DAYS=7
REMEMBER_COOKIE_DURATION_DAYS=7

# Password reset email (Gmail example)
# Use a Google App Password, not the account's normal password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT=20
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-account@gmail.com
